# Required — your Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — rate limiting (defaults shown)
PRAMAANA_IP_LIMIT=5       # fresh analyses per IP per 24h
PRAMAANA_GLOBAL_LIMIT=100 # total fresh analyses per 24h across all users

# Optional — database path (defaults to ./pramaana.db)
DB_PATH=./pramaana.db
