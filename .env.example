# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required — get one at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@host:5432/pramaana
# SQLite fallback — used only when DATABASE_URL is not set
DB_PATH=./pramaana.db

# ── Rate limiting ──────────────────────────────────────────────────────────────
PRAMAANA_IP_LIMIT=5        # fresh analyses per IP per 24h
PRAMAANA_GLOBAL_LIMIT=100  # total fresh analyses per 24h

# ── Admin ──────────────────────────────────────────────────────────────────────
# Required to access /admin moderation UI
ADMIN_TOKEN=change-me
